{
  "name": "aftercall",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @aftercall/desktop tauri dev",
    "dev:ui": "pnpm --filter @aftercall/desktop dev",
    "dev:web": "pnpm --filter @aftercall/web dev",
    "dev:backend": "pnpm --filter @aftercall/backend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "./scripts/verify.sh",
    "sample:notes": "pnpm --silent --filter @aftercall/core sample:notes",
    "samples:make": "node scripts/make-samples.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
