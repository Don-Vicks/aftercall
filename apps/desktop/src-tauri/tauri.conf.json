{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aftercall",
  "version": "0.1.0",
  "identifier": "dev.aftercall.app",
  "build": {
    "beforeDevCommand": "pnpm build:mcp && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Aftercall",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../mcp/dist/aftercall-mcp.mjs": "mcp/aftercall-mcp.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "14.2"
    }
  }
}
