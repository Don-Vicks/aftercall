{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, opener, notifications (Notes ready), and dragging the overlay title bar.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "opener:allow-reveal-item-in-dir",
    "notification:default"
  ]
}
