PORT=3001
# testnet or mainnet. Picks the default RPC and must match AFTERCALL_CONTRACT.
AFTERCALL_NETWORK=testnet
# NEAR RPC used to check sign-in keys and read the contract's stats. Empty: FastNEAR's free RPC for the network.
NEAR_RPC_URL=
# The agent-wallet contract. App keys limited to it may sign in for their account; GET /stats reads its counts.
# Aftercall's own on testnet (the app's built-in one, packages/core/src/network.ts). None on mainnet yet.
AFTERCALL_CONTRACT=wallet.aftercall.testnet
# At least 32 random characters, e.g. `openssl rand -hex 32`. Never commit the real value.
AUTH_JWT_SECRET=
# Resend (https://resend.com) for recap and claim emails. Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=notes@your-domain.example
# Postgres for claim links, daily limits and test-credit keys, e.g. postgres://localhost/aftercall_dev.
# Empty: kept in memory (development only).
DATABASE_URL=
# The web app's origin, allowed to call this API (Verify, sign and claim pages).
WEB_ORIGIN=http://localhost:3000

# Test credits: a capped NEAR AI key per install, from Aftercall's own NEAR AI workspace.
# All three empty: off, and the app asks for your own key. The account is a dedicated NEAR
# account used for nothing else; NEAR AI signs it in only with a full-access key.
NEARAI_ADMIN_ACCOUNT=
NEARAI_ADMIN_KEY=
NEARAI_WORKSPACE_ID=
# Each key's spend limit in USD, keys made in all, and keys per IP per day.
TESTER_KEY_LIMIT_USD=0.25
TESTER_KEYS_MAX=30
TESTER_KEYS_PER_IP_PER_DAY=3
