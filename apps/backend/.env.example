PORT=3001
# testnet or mainnet. Picks the default RPC and must match AFTERCALL_CONTRACT.
AFTERCALL_NETWORK=testnet
# NEAR RPC used to check sign-in keys and read the contract's stats. Empty: FastNEAR's free RPC for the network.
NEAR_RPC_URL=
# The agent-wallet contract. App keys limited to it may sign in for their account; GET /stats reads its counts.
AFTERCALL_CONTRACT=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Never commit the real value.
AUTH_JWT_SECRET=
# Resend (https://resend.com) for recap and claim emails. Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=notes@your-domain.example
# Postgres for claim links, e.g. postgres://localhost/aftercall_dev. Empty: kept in memory (development only).
DATABASE_URL=
