PORT=3001
# NEAR RPC used to check that a signing key belongs to the account.
NEAR_RPC_URL=https://rpc.testnet.near.org
# The agent-wallet contract. App keys limited to it may sign in for their account.
AFTERCALL_CONTRACT=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Never commit the real value.
AUTH_JWT_SECRET=
# Resend (https://resend.com) for recap and claim emails. Leave empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=notes@your-domain.example
