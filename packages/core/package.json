{
  "name": "@aftercall/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts src/notes/*.test.ts src/tee/*.test.ts src/wallet/*.test.ts src/followups/*.test.ts src/search/*.test.ts src/intents/*.test.ts src/node/*.test.ts src/relay/*.test.ts src/agents/*.test.ts",
    "sample:notes": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/sample-notes.ts",
    "phone:dev": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/phone-dev.ts",
    "proof:run": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/proof-run.ts",
    "nvidia:archive": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/archive-nvidia-keys.ts"
  },
  "devDependencies": {
    "@phala/dcap-qvl-node": "0.3.3",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "zod": "^3.25.76"
  }
}
